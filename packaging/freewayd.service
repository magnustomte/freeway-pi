[Unit]
Description=Freeway Pi ventilation gateway
# network.target, not network-online.target. Binding to 0.0.0.0 works before an
# address exists, the serial port needs no network at all, and waiting for
# NetworkManager-wait-online delayed the whole daemon by up to two minutes on
# first boot — or by its full timeout on a box with no carrier, for a wait that
# bought nothing.
After=network.target

# Restart without limit. The daemon exits when the serial adapter is absent,
# so the default rate limit would make an unplugged cable permanent: five
# quick failures and systemd gives up, and plugging it back in changes
# nothing. This key belongs in [Unit]; in [Service] systemd ignores it and
# says so only in the journal.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/opt/freeway/bin/freewayd -config /etc/freeway/config.json

User=freeway
Group=freeway
# The device node is root:dialout, so this is how the daemon reaches the
# adapter without being root.
SupplementaryGroups=dialout

# Port 502 is below 1024 and the Modbus clients expect it there. This is the
# one privilege the daemon keeps, and it keeps nothing else.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# The unit runs unattended for years. Everything it does not need is closed.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Writable state. The configuration is writable because the web interface will
# edit it; everything else on the filesystem is read-only to this process.
StateDirectory=freeway
ReadWritePaths=/etc/freeway

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
